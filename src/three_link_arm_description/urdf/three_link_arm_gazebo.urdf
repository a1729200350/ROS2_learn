<?xml version="1.0"?>
<robot name="three_link_arm">
  <!-- Gazebo 世界坐标系 -->
  <link name="world"/>
  <!-- 固定机械臂基座 -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>
  <!--底座-->
  <link name="base_link">
    <visual>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1.0"/>
    <inertia
      ixx="0.0018083333"
      ixy="0"
      ixz="0"
      iyy="0.0018083333"
      iyz="0"
      izz="0.0032"/>
    </inertial>
  </link>
  <!-- 机械臂安装坐标系：把平面3R竖起来 -->
  <link name="arm_base"/>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin
      xyz="0 0 0.05"
      rpy="0 -1.57079632679 0"/>
  </joint>
  <!--第一根连杆-->
  <link name="link1">
    <visual>
        <origin xyz="0.25 0 0"/>
        <geometry>
          <box size = "0.5 0.05 0.05"/>
        </geometry>
    </visual>
    <collision>
      <origin xyz="0.25 0 0"/>
      <geometry>
        <box size="0.5 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>

    <origin xyz="0.25 0 0" rpy="0 0 0"/>

    <mass value="1.0"/>
      <!--
      均匀密度长方体惯性公式:

      绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
      绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
      绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
      -->
    <inertia
        ixx="0.0004167"
        ixy="0"
        ixz="0"
        iyy="0.02104"
        iyz="0"
        izz="0.02104"/>

    </inertial>
  </link>
  <!--第一个关节-->
  <joint name="joint1" type="revolute">
    <parent link="arm_base"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit
        lower="-3.14"
        upper="3.14"
        effort="10"
        velocity="2"
    />
  </joint>
  <!--第二个连杆-->
  <link name="link2">
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size ="0.4 0.05 0.05"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size="0.4 0.05 0.05"/>
      </geometry>
    </collision>
    <inertial>

      <origin xyz="0.2 0 0" rpy="0 0 0"/>

      <mass value="0.8"/>

      <!--
      均匀密度长方体惯性公式:

      绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
      绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
      绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
      -->

      <inertia
          ixx="0.0003333"
          ixy="0"
          ixz="0"
          iyy="0.01083"
          iyz="0"
          izz="0.01083"/>

    </inertial>
  </link>
  <!--第二个关节-->
  <joint name="joint2" type="revolute">
  <parent link="link1"/>
  <child link="link2"/>
  <origin xyz="0.5 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit
    lower="-3.14"
    upper="3.14"
    effort="10"
    velocity="2"
  />
  </joint>
  <!--第三个连杆-->
  <link name="link3">
  <visual>
    <!-- 让关节在杆的一端 -->
    <origin xyz="0.20 0 0"/>
    <geometry>
      <box size ="0.4 0.05 0.05"/>
    </geometry>
    <material name="green">
      <color rgba="0 1 0 1"/>
    </material>
  </visual>
  <collision>

    <origin xyz="0.2 0 0"/>

    <geometry>
      <box size="0.4 0.05 0.05"/>
    </geometry>

  </collision>
  <inertial>

    <origin xyz="0.2 0 0" rpy="0 0 0"/>

    <mass value="0.8"/>

    <!--
    均匀密度长方体惯性公式:

    绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
    绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
    绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
    -->

    <inertia
        ixx="0.0003333"
        ixy="0"
        ixz="0"
        iyy="0.01083"
        iyz="0"
        izz="0.01083"/>

  </inertial>
  </link>
  <!--第三个关节-->
  <joint name="joint3" type="revolute">

    <parent link="link2"/>

    <child link="link3"/>

    <!-- joint3 在 link2 末端 -->
    <origin xyz="0.4 0 0" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>


    <limit
        lower="-3.14"
        upper="3.14"
        effort="10"
        velocity="2"/>

  </joint>
  <!--末端执行器坐标系-->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="link3"/>
    <child link="tool0"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
  </joint>
  
  <!-- link1：红色 -->
  <gazebo reference="link1">
    <visual>
      <material>
        <ambient>0.8 0.1 0.1 1</ambient>
        <diffuse>1.0 0.1 0.1 1</diffuse>
      </material>
    </visual>
  </gazebo>
  <!-- link2：红色 -->
  <gazebo reference="link2">
    <visual>
      <material>
        <ambient>0.8 0.1 0.1 1</ambient>
        <diffuse>1.0 0.1 0.1 1</diffuse>
      </material>
    </visual>
  </gazebo>
  <!-- link3：绿色，保留原来的区分 -->
  <gazebo reference="link3">
    <visual>
      <material>
        <ambient>0.1 0.7 0.1 1</ambient>
        <diffuse>0.1 1.0 0.1 1</diffuse>
      </material>
    </visual>
  </gazebo>

  <!-- Gazebo ros2_control 配置 -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">
          -0.8
        </param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">
          1.2
        </param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- 加载 Gazebo ros2_control 插件 -->
  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>
        $(find three_link_arm_description)/config/three_link_arm_controllers.yaml
      </parameters>
    </plugin>
  </gazebo>

</robot>
