<?xml version="1.0"?>
<robot name="two_link_arm">
  <!--底座-->
  <link name="base_link">
    <visual>
        <geometry>
          <cylinder radius="0.08" length="0.05"/>
        </geometry>
    </visual>
  </link>
  <!--第一根连杆-->
  <link name="link1">
    <visual>
        <origin xyz="0.25 0 0"/>
        <geometry>
          <box size = "0.5 0.05 0.05"/>
        </geometry>
    </visual>
    <inertial>

    <origin xyz="0.25 0 0" rpy="0 0 0"/>

    <mass value="1.0"/>
      <!--
      均匀密度长方体惯性公式:

      绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
      绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
      绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
      -->
    <inertia
        ixx="0.0004167"
        ixy="0"
        ixz="0"
        iyy="0.02104"
        iyz="0"
        izz="0.02104"/>

    </inertial>
  </link>
  <!--第一个关节-->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit
        lower="-3.14"
        upper="3.14"
        effort="10"
        velocity="2"
    />
  </joint>
  <!--第二个连杆-->
  <link name="link2">
    <visual>
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size ="0.4 0.05 0.05"/>
      </geometry>
    </visual>
    <inertial>

      <origin xyz="0.2 0 0" rpy="0 0 0"/>

      <mass value="0.8"/>

      <!--
      均匀密度长方体惯性公式:

      绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
      绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
      绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
      -->

      <inertia
          ixx="0.000167"
          ixy="0"
          ixz="0"
          iyy="0.01083"
          iyz="0"
          izz="0.01083"/>

    </inertial>
  </link>
  <!--第二个关节-->
  <joint name="joint2" type="revolute">
  <parent link="link1"/>
  <child link="link2"/>
  <origin xyz="0.5 0 0" rpy="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit
    lower="-3.14"
    upper="3.14"
    effort="10"
    velocity="2"
  />
  </joint>
  <!--第三个连杆-->
    <link name="link3">
    <visual>
      <!-- 让关节在杆的一端 -->
      <origin xyz="0.20 0 0"/>
      <geometry>
        <box size ="0.4 0.05 0.05"/>
      </geometry>
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
    <collision>

      <origin xyz="0.2 0 0"/>

      <geometry>
        <box size="0.4 0.05 0.05"/>
      </geometry>

    </collision>
    <inertial>

      <origin xyz="0.2 0 0" rpy="0 0 0"/>

      <mass value="0.8"/>

      <!--
      均匀密度长方体惯性公式:

      绕 x 轴: Ixx = (1/12) * m * (Ly^2 + Lz^2)
      绕 y 轴：Iyy = (1/12) * m * (Lx^2 + Lz^2)
      绕 z 轴：Izz = (1/12) * m * (Lx^2 + Ly^2)
      -->

      <inertia
          ixx="0.000167"
          ixy="0"
          ixz="0"
          iyy="0.01083"
          iyz="0"
          izz="0.01083"/>

    </inertial>
  </link>
  <!--第三个关节-->
  <joint name="joint3" type="revolute">

    <parent link="link2"/>

    <child link="link3"/>

    <!-- joint3 在 link2 末端 -->
    <origin xyz="0.4 0 0" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>


    <limit
        lower="-3.14"
        upper="3.14"
        effort="10"
        velocity="2"/>

  </joint>
  <!--末端执行器坐标系-->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="link3"/>
    <child link="tool0"/>
    <origin xyz="0.4 0 0" rpy="0 0 0"/>
  </joint>
</robot>
