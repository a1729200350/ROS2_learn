<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="three_link_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import three_link_arm urdf file -->
    <xacro:include filename="$(find three_link_arm_description)/urdf/three_link_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="three_link_arm.ros2_control.xacro" />


    <xacro:three_link_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
